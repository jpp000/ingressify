FROM node:20-alpine AS build
WORKDIR /app

COPY apresentacao-frontend/package.json apresentacao-frontend/package-lock.json ./
RUN npm ci

COPY apresentacao-frontend/ .
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
