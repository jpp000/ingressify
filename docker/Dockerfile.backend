FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace

COPY pom.xml .
COPY pai pai
COPY dominio-compartilhado dominio-compartilhado
COPY dominio-identidade dominio-identidade
COPY dominio-marketplace dominio-marketplace
COPY dominio-financeiro dominio-financeiro
COPY aplicacao aplicacao
COPY infraestrutura infraestrutura
COPY apresentacao-backend apresentacao-backend

RUN mvn -pl apresentacao-backend -am package -DskipTests

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
RUN groupadd -r spring && useradd -r -g spring spring
COPY --from=build --chown=spring:spring \
  /workspace/apresentacao-backend/target/ingressify-presentation-backend-0.0.1-SNAPSHOT.jar \
  app.jar
USER spring:spring
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
